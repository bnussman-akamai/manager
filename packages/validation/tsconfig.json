{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "./lib",
    "rootDir": "src",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "baseUrl": ".",
    "noUnusedLocals": true,
    "forceConsistentCasingInFileNames": true,
    "declarationMap": true,
    "incremental": true,
    "composite": true
  },
  "include": ["src"]
}
