{
  "compilerOptions": {
    "target": "esnext",
    "types": ["vitest/globals"],
    "module": "esnext",
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "./lib",
    "rootDir": "src",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "declarationMap": true,
    "incremental": true,
    "composite": true,
    "paths": {
      "@linode/validation*": ["../validation/lib/*"]
    }
  },
  "include": [
    "src"
  ],
  "exclude": ["node_modules"],
  "references": [
    { "path": "../validation" }
  ]
}
