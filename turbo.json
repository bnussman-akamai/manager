{
  "$schema": "https://turborepo.com/schema.json",
  "remoteCache": {
    "enabled": true,
    "apiUrl": "https://cache.nussman.us",
    "teamSlug": "cloud-manager"
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["lib/**", "build/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "start": {
      "dependsOn": ["^build"],
      "persistent": true,
      "cache": false
    }
  }
}